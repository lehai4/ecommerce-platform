generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  address   String?
  role      Role     @default(USER)
  /// Locked accounts cannot sign in or refresh their session
  blockedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  orders     Order[]
  reviews    Review[]
  cart       Cart?
  stockMovements StockMovement[]
  UserTokens UserTokens[]
}

model UserTokens {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  refreshToken String
  family       String   @unique
  browserInfo  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Product {
  id                 String        @id @default(uuid())
  name               String        @unique
  urlName            String        @unique
  /// Cover picture = url of the first image; kept in sync by ProductService
  picture            String?
  /// Stock keeping unit, unique code for inventory
  sku                String?       @unique
  /// Name and SKU without accents, lower case; used for accent-insensitive search
  searchText         String        @default("")
  basePrice          Decimal
  discountPercentage Int           @default(0)
  /// Price after discount; kept in sync by ProductService, used to filter/sort by price
  salePrice          Decimal       @default(0)
  stock              Int           @default(0)
  /// Units sold in non-cancelled orders; kept in sync by OrderService
  soldCount          Int           @default(0)
  /// Average of visible reviews (0 when none); kept in sync by ReviewService
  ratingAverage      Float         @default(0)
  ratingCount        Int           @default(0)
  status             ProductStatus @default(ACTIVE)
  description        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  /// Soft delete: hidden everywhere but kept so orders stay valid
  deletedAt          DateTime?
  categories         Category[]
  images             ProductImage[]
  reviews            Review[]
  cartItems          CartItem[]
  stockMovements     StockMovement[]
  orderItems         OrderItem[]

  @@index([status, deletedAt])
  @@index([salePrice])
  @@index([createdAt])
  @@index([soldCount])
  @@index([ratingAverage])
}

/// A product picture. position 0 is the cover.
model ProductImage {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  /// Cloudinary public_id ("local:<file>" for local storage); used to delete the file
  publicId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

/// DRAFT: being prepared, ACTIVE: visible in the shop, ARCHIVED: no longer sold
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id            String     @id @default(uuid())
  name          String     @unique
  /// URL friendly name, e.g. "ao-thun"
  slug          String     @unique
  description   String?
  image         String?
  imagePublicId String?
  /// Parent category; null for top level. Children are kept (moved to top level) when the parent is deleted
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId      String?
  children      Category[] @relation("CategoryTree")
  products      Product[]

  @@index([parentId])
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

/// A customer order. Holds a snapshot of the shipping details and totals at checkout time.
model Order {
  id   String @id @default(uuid())
  /// Human friendly order code, e.g. "OD-261118-7F3K2A"
  code String @unique

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  status OrderStatus @default(PENDING)

  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?

  customerName    String
  phone           String
  shippingAddress String
  note            String?

  /// Sum of base price * quantity
  subtotal      Decimal
  /// Sum of discounts applied to the items
  discountTotal Decimal @default(0)
  /// Amount the customer pays
  total         Decimal

  items   OrderItem[]
  history OrderStatusHistory[]
  stockMovements StockMovement[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([userId])
  @@index([createdAt])
}

/// One product line in an order. Product data is copied so the order stays correct
/// even if the product is later edited or deleted.
model OrderItem {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  productName        String
  productPicture     String?
  basePrice          Decimal
  discountPercentage Int     @default(0)
  /// Price per unit after discount
  unitPrice          Decimal
  quantity           Int
  /// unitPrice * quantity
  lineTotal          Decimal

  @@index([orderId])
  @@index([productId])
}

/// Every status change of an order, so admins can follow its progress.
model OrderStatusHistory {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  status      OrderStatus
  note        String?
  /// User who made the change (customer or admin); null for system changes
  changedById String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Why the stock of a product changed
enum StockReason {
  INITIAL
  SALE
  ORDER_CANCELLED
  RESTOCK
  ADJUSTMENT
}

/// One change of a product's stock, so every unit can be traced
model StockMovement {
  id         String      @id @default(uuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  /// Positive when stock goes up, negative when it goes down
  change     Int
  stockAfter Int
  reason     StockReason
  note       String?
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  /// Who made the change (admin, or the customer for sales/cancellations)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  createdAt  DateTime    @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([reason])
}

/// How the customer pays
enum PaymentMethod {
  /// Cash on delivery: paid when the order is delivered
  COD
  /// Bank transfer (VietQR), confirmed by an admin
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

/// A customer review of a product they received
model Review {
  id        String       @id @default(uuid())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  /// The delivered order the product came from
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  rating    Int
  comment   String?
  status    ReviewStatus @default(VISIBLE)
  /// Answer from the shop, shown under the review
  reply     String?
  repliedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  /// One review per product per order
  @@unique([orderId, productId])
  @@index([productId, status, createdAt])
  @@index([status])
}

/// A shopping cart: belongs to a user, or to a guest identified by a token
model Cart {
  id         String     @id @default(uuid())
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?    @unique
  /// Secret token kept by a guest's browser
  guestToken String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int
  /// Price after discount when the item was added, to warn about price changes
  priceWhenAdded Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}
