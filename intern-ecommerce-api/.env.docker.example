# Copy to .env.docker and fill in the values (used by docker-compose)

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ecommerce-backend"
POSTGRES_HOST="postgres"

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}?schema=intern&sslmode=prefer"

# 64 random characters, without the $ symbol
ACCESS_JWT_SECRET=""
REFRESH_JWT_SECRET=""
PORT=8070

# Optional: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""
CLOUDINARY_FOLDER="cms"

# Bank transfer payments (VietQR). BANK_ID is the VietQR bank code or BIN, e.g. "VCB" or "970436"
BANK_ID=""
BANK_ACCOUNT_NO=""
BANK_ACCOUNT_NAME=""
# Multiplier from order prices to the transferred amount (e.g. 25000 for USD -> VND). Default 1
BANK_TRANSFER_RATE="1"
# Time zone used to cut days in reports
APP_TIMEZONE="Asia/Ho_Chi_Minh"
