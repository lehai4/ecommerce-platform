# Database connection address
DATABASE_URL="postgresql://username:password@localhost:5432/ecommerce-backend?schema=public"

# Json Web Token secret
# Recomended 64 characters long
# Should not contain $ symbol
# Example: 7Rhgg*a^J2kpCU7&gG^mWv@7sVf4Q%D@TjF7T^mLab47e2R7LYZZJHr3QPj5qgK
ACCESS_JWT_SECRET=""
REFRESH_JWT_SECRET=""


# Cloudinary image storage (optional). When empty, images are saved in ./storage
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""
# Folder prefix inside your Cloudinary media library
CLOUDINARY_FOLDER="cms"

# Bank transfer payments (VietQR). BANK_ID is the VietQR bank code or BIN, e.g. "VCB" or "970436"
BANK_ID=""
BANK_ACCOUNT_NO=""
BANK_ACCOUNT_NAME=""
# Multiplier from order prices to the transferred amount (e.g. 25000 for USD -> VND). Default 1
BANK_TRANSFER_RATE="1"
# Time zone used to cut days in reports
APP_TIMEZONE="Asia/Ho_Chi_Minh"
